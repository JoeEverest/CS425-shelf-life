{
	"name": "server",
	"version": "0.0.1",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "bun --watch run src/index.ts & tsc --watch",
		"test": "bun --env-file=../.env test ./test",
		"type-check": "tsc --noEmit && tsc -p tsconfig.test.json"
	},
	"dependencies": {
		"db": "workspace:*",
		"drizzle-orm": "^0.44.5",
		"hono": "^4.12.32",
		"shared": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "latest"
	}
}
