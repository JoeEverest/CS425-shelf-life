{
	"name": "shelflife",
	"version": "0.1.0",
	"private": true,
	"description": "ShelfLife — general store management system (CS425 Software Engineering)",
	"author": "Joseph Everest Lyimo",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"./server",
		"./client",
		"./shared",
		"./db"
	],
	"scripts": {
		"dev": "turbo dev",
		"dev:client": "turbo dev --filter=client",
		"dev:server": "turbo dev --filter=server",
		"build": "turbo build",
		"type-check": "turbo type-check",
		"test": "turbo test",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"format:check": "biome format .",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:reset": "docker compose down -v && docker compose up -d",
		"db:generate": "bun run --cwd db generate",
		"db:migrate": "bun run --cwd db migrate",
		"db:seed": "bun run --cwd db seed",
		"postinstall": "turbo build --filter=shared --filter=server --filter=db"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"bun-types": "latest",
		"turbo": "^2.6.3",
		"typescript": "^5.8.3"
	}
}
